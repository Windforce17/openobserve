# syntax=docker/dockerfile:1
# Package the backend-only ARM64 binary produced by `cargo zigbuild` on the
# host. Build with `target/aarch64-unknown-linux-gnu/release-prod` as context;
# this keeps BuildKit away from source, frontend, and host build caches.
FROM public.ecr.aws/zinclabs/rust:trixie-sccache AS runtime-libs

FROM gcr.io/distroless/cc-debian13:latest-arm64 AS runtime
COPY openobserve /
COPY --from=runtime-libs /lib/aarch64-linux-gnu/liblzma.so.5 /lib/aarch64-linux-gnu/liblzma.so.5
COPY --from=runtime-libs /lib/aarch64-linux-gnu/libz.so.1 /lib/aarch64-linux-gnu/libz.so.1
COPY --from=runtime-libs /lib/aarch64-linux-gnu/libbz2.so.1.0 /lib/aarch64-linux-gnu/libbz2.so.1.0
RUN ["/openobserve", "init-dir", "-p", "/data/"]
CMD ["/openobserve"]
